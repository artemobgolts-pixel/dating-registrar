# ===== Скопируй этот файл в .env и заполни =====
#   cp .env.example .env

# Домен (без https:// и без слэша)
DOMAIN=date4you.online

# ОБЯЗАТЕЛЬНО. Секретный ключ для подписи сессий.
# Без него приложение не запустится. Сгенерируй командой:
#   openssl rand -hex 32
SECRET_KEY=

# ===== Вход через Telegram =====
# Вход в кабинет — без пароля, через бота (deep-link ?start=код).
# TG_BOT_TOKEN     — токен бота от @BotFather (он же шлёт уведомления).
# TG_BOT_USERNAME  — username бота БЕЗ @ (напр. date4you_bot). Нужен для кнопки входа.
# TG_CHAT_ID       — chat_id для уведомлений/алёртов оператору (см. README).
# TG_WEBHOOK_SECRET — произвольная длинная строка; её же передаёшь Telegram при
#                     setWebhook (?secret_token=...). Без неё вебхук входа не работает.
TG_BOT_TOKEN=
TG_BOT_USERNAME=
TG_CHAT_ID=
TG_WEBHOOK_SECRET=
# Необязательно: HTTPS URL Mini App. По умолчанию https://$DOMAIN/tg/app.
TG_MINI_APP_URL=

# Куда слать ежесуточный снимок базы (gzip) документом в Telegram.
# ОТДЕЛЬНЫЙ chat_id, не TG_CHAT_ID: в базе персональные данные посторонних,
# отправка наружу — осознанный выбор. Заведи ЗАКРЫТЫЙ канал или шли в «Избранное»
# (свой личный chat_id), не в общий чат уведомлений. Пусто — в TG не отправляется
# (остаётся снимок на диске и облачный бэкап через scripts/backup.sh).
TG_BACKUP_CHAT_ID=

# Операторы (суперадмины) — список telegram_id через запятую. Узнать свой id:
# напиши @userinfobot. При первом входе оператор «забирает» все существующие
# данные (легаси-владельца). Можно оставить пустым и вписать позже.
OPERATOR_TG_IDS=

# ===== OAuth-входы (Discord / Google / Yandex) =====
# Кнопки входа показываются всегда; без ключей провайдер отвечает «ещё не
# настроен». Заведи приложение у провайдера и впиши client_id/secret. В настройках
# приложения укажи Redirect URI РОВНО так (замени домен):
#   Discord: https://<домен>/auth/discord/callback   (scope: identify email)
#   Google:  https://<домен>/auth/google/callback    (OAuth consent + userinfo)
#   Yandex:  https://<домен>/auth/yandex/callback     (login:info login:email)
# Вход через OAuth заводит ОТДЕЛЬНЫЙ аккаунт (без Telegram); привязать соцсеть к
# уже существующему аккаунту можно из профиля (кнопка «Привязать»).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# ===== Страница «О проекте» (/about) и поддержка =====
# SUPPORT_CONTACT — контакт поддержки: @username, или t.me-ссылка, или любой URL.
#   Используется на /about и в тексте про расширение лимита событий.
SUPPORT_CONTACT=
# ABOUT_TEXT — короткий текст о проекте на /about (опционально, одна строка).
ABOUT_TEXT=
# AUTHOR_PROJECTS — СОБСТВЕННЫЕ проекты автора (не реклама третьих лиц).
#   Формат: «Название|https://ссылка» через точку с запятой. Пример:
#   AUTHOR_PROJECTS=Мой VPN|https://example.com;Блог|https://blog.example.com
AUTHOR_PROJECTS=
# Кнопки «Помощь» и «VPN» в шапке кабинета и на гостевой странице подборки.
#   SUPPORT_URL — связь с автором (по умолчанию t.me/artiwayn).
#   VPN_URL — проект автора (сайт бесплатный). Пустое значение прячет кнопку.
SUPPORT_URL=https://t.me/artiwayn
VPN_URL=https://lk.artik-vpn.site?campaign=date4you

# ===== Оптимизация MP4 =====
# ffmpeg в Docker-образе переставляет служебный блок MP4 в начало файла без
# перекодирования. Ошибка/таймаут оставляют проверенный исходник. При необходимости
# можно отключить, указав VIDEO_FASTSTART=false.
VIDEO_FASTSTART=true
# FFMPEG_BIN=ffmpeg

# Куки только по HTTPS. Не трогай, если сайт работает по https (а он работает).
COOKIE_SECURE=true

# Экспериментальный поиск под заголовком «Лента событий». false мгновенно
# возвращает прежний интерфейс и прежний путь ранжирования без отката кода.
COMMUNITY_SEARCH_ENABLED=true

# ===== Наблюдаемость =====
# Среда и релиз попадают в логи/Sentry. APP_RELEASE лучше задавать git SHA.
APP_ENV=production
APP_RELEASE=unknown
LOG_LEVEL=INFO
# pretty — компактный читаемый вывод, json — для jq и систем сбора логов.
LOG_FORMAT=pretty
# Если задать DSN, необработанные 500-е уйдут в Sentry. По умолчанию сохраняется
# 5% performance traces; 0 полностью отключает tracing, не отключая ошибки.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
