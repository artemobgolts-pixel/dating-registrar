# ===== Скопируй этот файл в .env и заполни =====
#   cp .env.example .env

# Домен (без https:// и без слэша)
DOMAIN=boris-i-love-you.online

# ОБЯЗАТЕЛЬНО. Секретный ключ для подписи сессий админки.
# Без него приложение не запустится. Сгенерируй командой:
#   openssl rand -hex 32
SECRET_KEY=

# Логин и пароль админки (вход на https://домен/admin).
# ADMIN_PASSWORD обязателен — без него приложение не запустится.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Уведомления в Telegram (можно оставить пустыми — тогда уведомлений не будет)
# TG_BOT_TOKEN — токен бота от @BotFather
# TG_CHAT_ID   — твой chat_id (см. README, раздел «Telegram-уведомления»)
TG_BOT_TOKEN=
TG_CHAT_ID=

# Куки только по HTTPS. Не трогай, если сайт работает по https (а он работает).
COOKIE_SECURE=true

# Мониторинг ошибок (опционально). Если задать DSN и поставить пакет
# `pip install sentry-sdk`, необработанные 500-е уйдут в Sentry. Без него
# 500-е всё равно логируются и шлются алёртом в Telegram (TG_BOT_TOKEN/TG_CHAT_ID).
SENTRY_DSN=
