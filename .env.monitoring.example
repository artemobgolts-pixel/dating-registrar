# Скопируй в .env.monitoring только при запуске opt-in профиля monitoring:
#   cp .env.monitoring.example .env.monitoring
#
# ОБЯЗАТЕЛЬНО. Сгенерируй стойкий пароль, например: openssl rand -hex 24
# Compose монтирует значение в Grafana как secret-файл. Отдельный env-файл
# не передаётся app-контейнеру, в отличие от основного .env.
GRAFANA_ADMIN_PASSWORD=

# Срок хранения локальных метрик Prometheus (например 7d, 30d, 90d).
PROMETHEUS_RETENTION=30d
