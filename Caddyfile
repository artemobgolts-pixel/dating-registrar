# Caddy сам получает и продлевает сертификат Let's Encrypt для домена.
# Домен берётся из переменной DOMAIN в .env

{$DOMAIN} {
	encode gzip zstd

	# до 2 видео по 60 МБ + 5 фото по 10 МБ + запас на multipart-форму
	request_body {
		max_size 200MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-XSS-Protection "0"
		# CSP и X-Frame-Options выставляет приложение: Mini App разрешает frame
		# только Telegram, все остальные HTML-страницы получают DENY.
		-Server
	}

	# Метрики доступны только collector-у внутри Docker-сети через app:8000.
	# Снаружи не раскрываем имена маршрутов, состояние очереди и процесса.
	@metrics path /metrics /metrics/* /ready /ready/*
	handle @metrics {
		respond 404
	}

	# Append-only файлы из проверенного image; старые URL сохраняют свои байты.
	@staticVersioned {
		path /static/*
		query v=*
	}
	handle @staticVersioned {
		@badVersion expression !{query.v}.matches('^[0-9a-f]{12}$')
		respond @badVersion 404
		root * /srv/assets
		rewrite * /{query.v}{path}
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy app:8000 {
			# Перезаписываем (не дописываем!) реальный IP клиента — лимиты
			# в приложении читают только этот заголовок, его нельзя подделать
			header_up X-Real-IP {remote_host}
			# Публичному X-Request-ID не доверяем: иначе клиент сможет отправить
			# произвольное значение в логи и Sentry-теги корреляции.
			header_up X-Request-ID {http.request.uuid}
		}
	}
}

# DNS-запись www указывает на тот же IP; поисковые и обычные переходы всегда
# сводим к одному каноническому хосту без www.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
