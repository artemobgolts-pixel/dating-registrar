# Caddy сам получает и продлевает сертификат Let's Encrypt для домена.
# Домен берётся из переменной DOMAIN в .env

{$DOMAIN} {
	encode gzip zstd

	# до 2 видео по 60 МБ + 5 фото по 10 МБ + запас на multipart-форму
	request_body {
		max_size 200MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-XSS-Protection "0"
		# CSP и X-Frame-Options выставляет приложение: Mini App разрешает frame
		# только Telegram, все остальные HTML-страницы получают DENY.
		-Server
	}

	# Публичную статику отдаём напрямую, не занимая воркеры приложения.
	# ?v=<хэш содержимого> формирует web.asset(), поэтому такая ссылка immutable.
	@staticVersioned {
		path /static/*
		query v=*
	}
	@staticUnversioned {
		path /static/*
		not query v=*
	}
	handle /static/* {
		root * /srv

		header @staticVersioned Cache-Control "public, max-age=31536000, immutable"
		header @staticUnversioned Cache-Control "public, max-age=3600, must-revalidate"

		file_server
	}

	handle {
		reverse_proxy app:8000 {
			# Перезаписываем (не дописываем!) реальный IP клиента — лимиты
			# в приложении читают только этот заголовок, его нельзя подделать
			header_up X-Real-IP {remote_host}
		}
	}
}

# Если захочешь, чтобы работал и www-поддомен:
# 1) добавь в Reg.ru A-запись "www" на тот же IP
# 2) раскомментируй блок ниже
#
# www.{$DOMAIN} {
# 	redir https://{$DOMAIN}{uri} permanent
# }
